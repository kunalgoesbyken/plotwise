# Optional. With both set, the API rate limits are shared across server instances in an Upstash Redis database.
# Without them, each server instance counts on its own in memory.
# The Upstash integration in the Vercel Marketplace sets KV_REST_API_URL and KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
