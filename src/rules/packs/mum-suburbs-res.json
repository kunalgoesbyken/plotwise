  "questions": [],
  "gaps": [
    {
      "id": "later-modifications",
      "what": "Modifications to DCPR 2034 after 8 May 2018, among them the 14 Oct 2024 notification on premium and TDR and the Reg 30(A) road-widening order",
      "why": "The only machine-readable official text is the 2018 sanctioned text. The 2024 notification PDF has a garbled legacy-font text layer, and Table 12 Note 2 lets the Government change the premium and TDR split. This pack is a draft as sanctioned in 2018."
    },
    {
      "id": "table-a-side-rear",
      "what": "Side and rear open spaces by building height and plot size (Reg 41(2)(i)(a), Table A, p288)",
      "why": "The text layer merges and dashes the cells of Table A, so which cell holds which value cannot be read. The side and rear open space is entered for each plot."
    },
    {
      "id": "table-a-tower-rules",
      "what": "Tower open spaces and step-backs above 32 m, 70 m and 120 m (p289) and the dead-wall column of Table A",
      "why": "Part of the unreadable Table A layout; not applied."
    },
    {
      "id": "height-exemptions",
      "what": "The road-height rule ceasing for plots with a 9 m or 12 m front margin, and aerodrome height limits (Reg 43(1), Reg 43(B))",
      "why": "Not modelled; the road-height rule is applied to every plot."
    },
    {
      "id": "road-width-meaning",
      "what": "Whether the Table 12 road width is the existing or the prescribed width",
      "why": "Table 12 Note 1 moves a 6 m to 9 m road proposed to be widened to the 9 m row. Plotwise reads every band, and the height rule, from the widened width once a prescribed width is entered."
    },
    {
      "id": "asr-land-rate",
      "what": "Annual Schedule of Rates land value for the plot",
      "why": "Published only through the eASR web form at easr.igrmaharashtra.gov.in, one zone at a time. It is entered by the user."
    },
    {
      "id": "tdr-market-price",
      "what": "Market price of TDR",
      "why": "No official price; Reg 32 fixes how much TDR is generated, not its price. It is entered by the user."
    },
    {
      "id": "zone-and-road-maps",
      "what": "Which plots are in the R zone of the suburbs, and the DP road widths and regular lines",
      "why": "They are on the development plan maps, not in the DCPR text. The user confirms the zone and enters any prescribed road width."
    },
    {
      "id": "other-uses",
      "what": "Offices, hotels and other occupancies",
      "why": "This draft covers residential buildings in the R zone only."
    },
    {
      "id": "coverage",
      "what": "Ground coverage",
      "why": "Reg 41(1) to (3) set no general coverage share for this zone; coverage follows from the open spaces and FSI."
    },
    {
      "id": "inclusive-housing-and-amenities",
      "what": "Inclusive housing on plots of 4000 m² or more (Reg 15), layout open space and amenity handover (Reg 27, Reg 14), and FSI-exempt areas (Reg 31(1))",
      "why": "Not modelled in this draft."
    },
    {
      "id": "charges",
      "what": "Development cess and the development charge",
      "why": "Reg 30(A)(7) sets a cess of 100% of the development charge, whose rate was not read."
    },
    {
      "id": "table-12-columns",
      "what": "The column of each repeated Table 12 value (0.5 premium and 0.5 TDR on the 9 m row, 1.0 basic and 1.0 TDR on the 27 m row)",
      "why": "The text layer cannot say which column a repeated value sits in; the values are equal, so the numbers are right but the cite is to the line."
    },
    {
      "id": "low-rise-scope",
      "what": "Whether Table No 17 replaces Table A and Table 18 A or only relaxes them",
      "why": "Reg 41(3)(a) says the open spaces may be relaxed to Table No 17; Plotwise applies it to the checks of a building of ground and one upper floor on a plot it covers, and keeps the envelope on the stricter open spaces. The rear is taken as the boundary edge farthest from the main road."
    }
  ]
}
